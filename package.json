{
  "name": "ultikynnys-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Express server for the Windows XP-inspired portfolio site",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run typecheck && npm run build:browser && npm run build:server",
    "build:browser": "esbuild scripts/portfolio.ts scripts/cv.ts scripts/desktop.ts --bundle --outdir=dist/scripts --target=es2020 --sourcemap",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx server.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-free": "^6.0.0",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/logos": "^1.2.16",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/thesvg-color": "^1.2.16",
    "@playwright/test": "^1.64.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=18"
  }
}
